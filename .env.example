CONTENT_RATING=safe
HAS_CHAPTERS=true
USERNAME_FORMAT=Reading {title}
MANGA_DESCRIPTION_MAX_LENGTH=100

# Optional endpoint overrides
SUICAODEX_API_BASE_URL=https://redive.suicaodex.com
DISCORD_API_BASE_URL=https://discord.com/api/v9
